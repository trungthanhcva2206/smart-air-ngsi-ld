# ========================================
# Smart Air NGSI-LD - Environment Configuration Template
# ========================================
# 📋 Instructions:
#   1. Copy this file to .env:
#      cp .env.example .env
#   2. Fill in your actual values (especially API keys and passwords)
#   3. Never commit .env to git (already in .gitignore)
# ========================================
# Smart Air NGSI-LD - Example env (sanitized)
# Copy this to .env and fill real values locally (do NOT commit .env)

# VPS & Domain
VPS_IP=127.0.0.1
DOMAIN=localhost
SSL_ENABLED=false
# Mật khẩu quản trị MongoDB (Dùng cho Orion, IoT Agent)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_SECURE_ROOT_PASS

# Tài khoản & Mật khẩu MQTT (Dùng cho IoT Agent, ETL, Code ESP32)
MQTT_USERNAME=smartair_device
MQTT_PASSWORD=REPLACE_WITH_SECURE_ROOT_PASS
# Public URLs
FRONTEND_PUBLIC_URL=http://localhost:5137
BACKEND_PUBLIC_URL=http://localhost:8123
ROUTE_PUBLIC_URL=http://localhost:5000
GRAFANA_PUBLIC_URL=http://localhost:3000

# OpenWeather API
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# ETL / App config
ETL_MODE=dual
ETL_INTERVAL_MINUTES=480
LOG_LEVEL=INFO
HANOI_GEOJSON_PATH=etl/Data/ha_noi_with_latlon2.geojson

# FIWARE Orion-LD (Docker internal)
ORION_LD_URL=http://orion:1026
ORION_LD_TENANT=hanoi
ORION_SERVICE_PATH=/

# QuantumLeap
QUANTUMLEAP_EXTERNAL_URL=http://quantumleap:8668
QUANTUMLEAP_INTERNAL_URL=http://quantumleap:8668
QUANTUMLEAP_ENABLED=true
QUANTUMLEAP_FIWARE_SERVICE=hanoi
QUANTUMLEAP_QUERY_LASTN=720
QUANTUMLEAP_QUERY_DELAY_SECONDS=2

# MQTT Broker
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_BROKER_DOCKER_HOST=mosquitto

# IoT Agent
IOT_AGENT_URL=http://iot-agent:4041
IOT_AGENT_DOCKER_URL=http://iot-agent:4041
IOT_AGENT_HTTP_PORT=7896
FIWARE_SERVICE=hanoi
FIWARE_API_KEY=hanoi

# MySQL (replace with secure production values locally)
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SECURE_ROOT_PASS
MYSQL_DATABASE=smartair_db
MYSQL_USER=smartair
MYSQL_PASSWORD=REPLACE_WITH_SECURE_DB_PASS
MYSQL_HOST=mysql-db
MYSQL_PORT=3306

SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/smartair_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh

# Timescale/Postgres (QuantumLeap)
POSTGRES_USER=quantumleap
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_POSTGRES_PASS
POSTGRES_DB=quantumleap
TIMESCALE_HOST=timescale-db
TIMESCALE_PORT=5432

# Redis
REDIS_HOST=redis-cache
REDIS_PORT=6379

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
GRAFANA_PORT=3000

# Backend
BACKEND_PORT=8123
BACKEND_URL=http://backend:8123
BACKEND_DOCKER_URL=http://backend:8123

# Timeouts
SPRING_WEBFLUX_CLIENT_CONNECT_TIMEOUT=10000
SPRING_WEBFLUX_CLIENT_READ_TIMEOUT=30000
SPRING_WEBFLUX_CLIENT_WRITE_TIMEOUT=30000

# Mail (do NOT store real password in repo)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=you@example.com
SPRING_MAIL_PASSWORD=REPLACE_WITH_MAIL_APP_PASSWORD
MAIL_FROM_NAME=Smart Air Quality Alert System - AirTrack Pro

# Frontend / Vite build
FRONTEND_PORT=5137
VITE_API_URL=http://localhost:8123
VITE_API_ROUTE_URL=http://localhost:5000
FRONTEND_PUBLIC_URL=http://localhost:5137

# Route finding service
ROUTE_FINDING_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# Graph & files
GRAPH_FILE=hanoi_road_network.graphml
GEOJSON_FILE=ha_noi_with_latlon2.geojson

# SSE endpoint (internal)
SSE_ENDPOINT=http://backend:8123/api/sse/environment-data

# Data refresh
REFRESH_INTERVAL_SECONDS=3600

# Notification tokens (replace locally)
BLYNK_TOKEN=REPLACE_WITH_BLYNK_TOKEN
BLYNK_SERVER=blynk.cloud
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_TOKEN

# Webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=4999
WEBHOOK_URL=http://webhook.example.com

# Docker network / host
DOCKER_NETWORK=fiware-network
DOCKER_HOST_GATEWAY=172.17.0.1

# Security
JWT_SECRET=REPLACE_WITH_RANDOM_SECURE_JWT_SECRET
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5137